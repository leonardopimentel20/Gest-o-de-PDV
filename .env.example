# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" NUNCA deve ser enviado para o Git nem compartilhado.

# Banco de dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sistema
DB_PASSWORD=coloque_a_senha_real_aqui
DB_NAME=loja_variedades

# Autenticação (gere uma chave longa e aleatória, nunca reaproveite esta de exemplo)
JWT_SECRET=gere_uma_chave_bem_grande_e_aleatoria_aqui
JWT_EXPIRES_IN=8h

# Porta do servidor
PORT=3000

# Local por padrão. Para demonstração na Azure, consulte AZURE.md.
DEPLOY_TARGET=local
HOST=127.0.0.1
DB_SSL=false
# CA pública opcional em PEM; nunca desative a verificação do certificado.
DB_SSL_CA_PATH=
# local preserva a configuração atual. Na Azure, use -03:00 para esta loja.
DB_TIMEZONE=local

# Origens externas permitidas a chamar a API (separadas por vírgula).
# Deixe em branco se o front-end for servido pelo próprio servidor (padrão deste projeto).
ALLOWED_ORIGINS=

# Backups: pasta externa à aplicação e à pasta de dados do banco.
# Exemplo: BACKUP_DIR="D:/BackupsPDV" (ideal: outra unidade ou pasta sincronizada)
# Vazio = backup automático desativado. Não altera onde o MySQL salva os dados.
BACKUP_DIR=
BACKUP_INTERVAL_MINUTES=30
# Opcional para MariaDB em Program Files; obrigatório se não for localizado.
# Exemplo: BACKUP_DUMP_EXE="C:/Program Files/MariaDB 12.3/bin/mariadb-dump.exe"
BACKUP_DUMP_EXE=
